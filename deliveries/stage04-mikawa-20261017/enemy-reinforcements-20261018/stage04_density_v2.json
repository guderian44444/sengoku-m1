  "global_rules": {
    "user_requirement": "Every node has 2-3 reinforcement batches after its separate initial force; every batch6-8 total from two directions,3-4 each side.",
    "phase_model": "initial -> finite reinforcement batches -> drain -> clear; bosses/escorts are separately accounted pools",
    "wave_trigger": "Previous batch fully admitted; living+entering regular enemies <=2; all pending batch reservations included in capacity. Boss and Kira escort pools excluded from regular threshold. First Kira wave eligible when boss introduction ends.",
    "initial_placement": "Regular initial soldiers visibly staged in forward half of encounter, not hidden in reeds; begin combat after entry/introduction. Boss introductions freeze admissions and attacks.",
    "wave_admission": "Reserve entire next batch once; left/right screen-edge warning immediately, then first pair after45 ticks. Admit one left+one right every45 ticks,3-4 pairs. Waiting offscreen counts as entering/cap once actor exists. Wave sequence records are unique per encounter epoch.",
    "why_not_240_ticks": "Stage03 death-refill waits240 ticks/4s. New finite wave takes45 ticks/.75s from trigger to first pair to avoid several seconds of empty scene; is new proposal, not observed Stage03 behavior.",
    "entry": "Left and right offscreen approach, safe free ground lanes, no visible teleport, no spawn inside fence/player; queues retry when blocked and never silently drop required soldiers.",
    "capacity": "Normal cap10; Tominaga/Udono cap11 including boss; Kira cap15 including boss+6 escorts+regular8. Counts include entering living actors and reserved batch slots; decorative8 excluded.",
    "coop": "Use identical explicitly-authored wave counts and caps for1/2players; do NOT apply generic _scaled_wave +50% on top (would break per-wave6-8). Existing Stage04 HP/difficulty rules remain, no new HP/damage/cooldown reduction.",
    "clear": "All finite batches admitted, queue/reservations empty, all required living enemies defeated; then right exit. No mandatory flag/cheval/background kills. Kira and final boss exceptions below.",
    "boss_early_defeat": "Never delete remaining finite wave budget when boss defeated. Already fighting and later finite batches must still be resolved. No boss invulnerability or artificial HP lock introduced.",
    "preserve": "5sections3/2/3/2/3; mud nodes4/5 slows both and forbids player jump initiation; no reed ambush; node7opens bridge without NPC; all miniboss/boss moves and existing shield contracts preserved.",
    "future_test": "Validate density, duration, entry latency, both-side readability, camera space, projectile collisions, all6heroes and1/2players; all numbers unmeasured."
  },
