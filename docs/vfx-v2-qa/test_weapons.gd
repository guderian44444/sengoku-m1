extends SceneTree
const E=preload("res://vfx/v2/effect_emitter.gd")
const W=preload("res://vfx/v2/weapon_motion.gd")
var events=[]
func _initialize() -> void: run.call_deferred()
func run() -> void:
 assert(W.muzzle_anchor(Vector2(100,100),Vector2(20,-10),200,100,-1,5,10,PI/2).is_equal_approx(Vector2(110,55)))
 assert(W.muzzle_anchor(Vector2(100,100),Vector2(20,-10),100,100,1)==Vector2(120,90))
 var slash=W.slash_binding(Vector2(0,0),Vector2(0,100))
 assert(slash.face==1 and is_equal_approx(slash.rotation,PI/2) and slash.size_multiplier==1)
 var trail=W.trail_binding(Vector2(10,10),Vector2(-600,0))
 assert(trail.face==1 and is_equal_approx(abs(trail.rotation),PI) and is_equal_approx(trail.size_multiplier,48.0/180.0))
 assert(not W.trail_binding(Vector2.ZERO,Vector2.ZERO).visible)
 var e=E.new();root.add_child(e);assert(e.configure())
 e.audio_cue.connect(func(id,key,op,ctx):events.append([id,key,op,ctx]))
 assert(not e.trigger("reload","hero_matchlock",{"shot_event_id":"fake"}))
 assert(not e.trigger("input_pressed","hero_matchlock",{"confirmed_shot":true}))
 assert(events.is_empty())
 assert(e.trigger("gun","hero_matchlock",{"confirmed_shot":true,"shot_event_id":"real1","simulation_tick":100,"variant":2,"distance":1.0}))
 assert(events.size()==1 and events[0][1]=="hero_matchlock_shot_2" and events[0][3].distance==1.0)
 assert(not e.trigger("same-event-other-id","hero_matchlock",{"confirmed_shot":true,"shot_event_id":"real1"}))
 assert(not e.confirmed_hit("gun","target",101))
 e.advance("gun",106);assert(e.instances.gun.phase=="dissipate")
 assert(events.size()==1)
 e.cancel("gun");assert(events[-1][2]=="stop_all")
 assert(not e.trigger("same-after-cancel","hero_matchlock",{"confirmed_shot":true,"shot_event_id":"real1"}))
 for i in range(10):assert(e.trigger("enemy"+str(i),"enemy_matchlock",{"confirmed_shot":true,"shot_event_id":"enemy-shot"+str(i),"variant":i%4}))
 assert(e.instances.size()==10)
 e.reset_scene();assert(e.shot_events.is_empty())
 e.queue_free();await process_frame
 print("PASS independent weapons: muzzle face/scale/rotation/camera/z math; world-facing slash/trail bindings; zero-speed hidden; confirmed-shot gate/dedup/cancel; no reload/hit shot; 6tick flash; ten-enemy unique events")
 quit()
