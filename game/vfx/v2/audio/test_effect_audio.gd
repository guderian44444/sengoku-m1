extends SceneTree
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var c = load("res://vfx/v2/audio/effect_audio_controller.gd").new()
	root.add_child(c)
	assert(c.configure("res://vfx/v2/audio/"))
	for el in ["blade", "fire", "ice", "wind", "lightning"]:
		assert(c.handle_cue(el, el + "_activate", "start"))
		assert(c.handle_cue(el, el + "_charge_loop", "loop_start"))
		var count: int = c.players.size()
		assert(c.handle_cue(el, el + "_charge_loop", "loop_start"))
		assert(c.players.size() == count)
		c.update_instance(el, 0.8, 0.6)
	assert(c.loops.size() == 5)
	c.set_paused(true)
	assert(c.handle_cue("paused", "wind_charge_loop", "loop_start"))
	for p in c.players: assert(p.stream_paused)
	c.set_voice_duck(true)
	for p in c.players: assert(p.volume_db <= -24.0)
	c.set_paused(false)
	c.handle_cue("fire", "fire_charge_loop", "loop_stop")
	c.handle_cue("fire", "fire_release", "start")
	assert(not c.loops.has("fire:fire_charge_loop"))
	c.stop_instance("fire")
	assert(c.handle_cue("fire", "fire_charge_loop", "loop_start"))
	assert(c.loops.has("fire:fire_charge_loop"))
	# Simulation rewinds are reset by the emitter; controller accepts a clean replay.
	c.stop_instance("fire")
	c.handle_cue("fire", "fire_activate", "start")
	for i in range(40): c.handle_cue("burst", "lightning_hit", "start")
	assert(c.players.size() <= 12)
	var burst_count := 0
	for p in c.players:
		if str(p.get_meta("instance")) == "burst": burst_count += 1
	assert(burst_count <= 5)
	c.set_paused(true)
	c.handle_cue("cancel", "ice_charge_loop", "loop_start")
	c.handle_cue("cancel", "", "stop_all")
	assert(not c.loops.has("cancel:ice_charge_loop"))
	assert(not c.handle_cue("x", "missing", "start"))
	c.stop_all()
	assert(c.players.is_empty() and c.loops.is_empty())
	c.set_paused(false)
	c.handle_cue("finish_test", "wind_charge_loop", "loop_start")
	c.handle_cue("finish_test", "wind_dissipate", "start")
	c.handle_cue("finish_test", "", "finish")
	assert(not c.loops.has("finish_test:wind_charge_loop"))
	assert(c.instances.has("finish_test"))
	await create_timer(0.9).timeout
	assert(not c.instances.has("finish_test"))
	assert(c.finishing.is_empty() and c.players.is_empty())
	c.set_voice_duck(false)
	c.handle_cue("near", "hero_matchlock_shot_0", "start", {"phase_progress": 1.0})
	c.handle_cue("far", "hero_matchlock_shot_0", "start", {"phase_progress": 1.0, "distance": 1.0})
	assert(is_equal_approx(c.players[0].volume_db - c.players[1].volume_db, 12.0))
	c.stop_all()
	c.handle_cue("base", "neutral_slash_arc", "start", {"phase_progress": 1.0})
	c.handle_cue("layer", "neutral_slash_arc", "start", {"phase_progress": 1.0, "layered": true})
	assert(is_equal_approx(c.players[0].volume_db - c.players[1].volume_db, 6.0))
	c.stop_all()
	assert(not c.handle_cue("arrow", "arrow_trail", "loop_start"))
	c.queue_free()
	await create_timer(0.2).timeout
	print("PASS five concurrent elements, duplicate loop, loop-release, reused id, rewind reset, paused spawn/cancel, duck, caps, clean stop")
	quit()
