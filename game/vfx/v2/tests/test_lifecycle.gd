extends SceneTree
const Emitter=preload("res://vfx/v2/effect_emitter.gd")
const Curves=preload("res://vfx/v2/phase_curves.gd")
var events: Array=[]
func _initialize() -> void:
	_run.call_deferred()
func _run() -> void:
	assert(is_equal_approx(Curves.integral([[0,0],[1,2]],1),1))
	assert(is_equal_approx(Curves.integral([[0,0],[1,2]],2),3))
	assert(not Curves.valid([[0,1],[0,2]]))
	var fx=Emitter.new();root.add_child(fx);assert(fx.configure())
	fx.audio_cue.connect(func(id,key,op,context):events.append([id,key,op,context]))
	assert(fx.trigger("hold:1","fire_charged_wave",{"simulation_tick":100}))
	assert(not fx.trigger("hold:1","fire_charged_wave"))
	assert(events.size()==2)
	fx.advance("hold:1",220);assert(fx.instances["hold:1"].phase=="charge")
	assert(not fx.confirmed_hit("hold:1","bad_charge_hit",220))
	fx.set_paused(true);fx.advance("hold:1",240);assert(fx.instances["hold:1"].last_tick==220)
	assert(not fx.release("hold:1",240))
	fx.set_paused(false);assert(fx.release("hold:1",220))
	assert(events[-2][2]=="loop_stop" and events[-1][1]=="fire_release")
	assert(not fx.release("hold:1",220))
	assert(fx.confirmed_hit("hold:1","hitA",232));assert(fx.instances["hold:1"].last_tick==232)
	assert(not fx.confirmed_hit("hold:1","hitA",232))
	assert(not fx.confirmed_hit("hold:1","hitB",230))
	fx.advance("hold:1",262);assert(not fx.instances.has("hold:1"))
	assert(events[-1][2]=="finish")
	fx.cancel("hold:1");assert(events[-1][2]=="stop_all")
	assert(fx.trigger("spin:1","wind_growing_spin"))
	var before:=events.size();fx.advance("spin:1",40)
	assert(events.size()==before+1 and events[-1][1]=="wind_release")
	fx.advance("spin:1",40);assert(events.size()==before+1)
	fx.advance("spin:1",90);assert(not fx.instances.has("spin:1"))
	assert(not fx.trigger("unconfirmed","ice_impact"))
	fx.recipes.wind_growing_spin.phases.release.cues.append({"tick":70,"phase":"release"})
	assert(fx.trigger("late:1","wind_growing_spin"))
	before=events.size()
	fx.advance("late:1",1000)
	assert(events.size()==before+1 and events[-1][2]=="finish")
	fx.reset_scene();assert(fx.instances.is_empty() and fx.retired.is_empty())
	fx.queue_free();await process_frame
	print("PASS v2 lifecycle: hold/release, pause, unique hits, out-of-order reject, second-turn cue, finished-tail cancel, reset; analytical curves")
	quit()
